{
  "manifest_version": 3,
  "name": "B-Kit Manual Recorder",
  "version": "1.0",
  "description": "사용자의 행동을 녹화하여 매뉴얼을 자동 생성하는 크롬 확장 프로그램입니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
